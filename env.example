# Required: generate fresh random secrets. This file contains no usable credentials.
FLASK_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Prefer ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD where practical.
# ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=https://files.example.com
DAVALLKA_API_TOKENS={}
# For an MCP bridge, inject a matching private scoped API token:
# DAVALLKA_MCP_API_TOKEN=
# DAVALLKA_API_URL=https://files.example.com
PORT=8080
UPLOAD_FOLDER=uploads
STATE_FOLDER=state
COOKIE_SECURE=true
